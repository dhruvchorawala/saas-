NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/price_compare
# Use a long random string (any text works locally)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
# Frontend URL (used for CORS and password-reset links)
CLIENT_URL=http://localhost:3000

# Price refresh settings
REFRESH_INTERVAL_HOURS=6
REFRESH_CONCURRENCY=2
ENABLE_SCHEDULER=true

# Optional: email alerts & password reset. Leave empty to use in-app notifications only.
# Free option: a Gmail account + App Password (smtp.gmail.com, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
